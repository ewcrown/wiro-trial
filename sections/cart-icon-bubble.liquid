{%- liquid
  assign visible_count = 0
  for item in cart.items
    unless item.properties['_is_gift_wrap'] == 'true' or item.product.handle == 'gift-wrap-product'
      assign visible_count = visible_count | plus: item.quantity
    endunless
  endfor
-%}
{% if cart == empty or visible_count == 0 %}
  <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
{% else %}
  <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
{% endif %}

<span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
{%- if visible_count > 0 -%}
  <div class="cart-count-bubble">
    {%- if visible_count < 100 -%}
      <span aria-hidden="true">{{ visible_count }}</span>
    {%- endif -%}
    <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: visible_count }}</span>
  </div>
{%- endif -%}
